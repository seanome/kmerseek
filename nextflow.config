// Nextflow configuration for kmerseek pipeline

// Get current date for file naming
def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

// Enable execution reports
trace {
    enabled = true
    file = "kmerseek_scope40.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled = true
    file = "kmerseek_scope40.${today}.timeline.html"
}

report {
    enabled = true
    file = "kmerseek_scope40.${today}.report.html"
}

// Process configuration
process {
    // Default resource allocation
    cpus = 1
    memory = '4 GB'
    time = '12h'

    // Process-specific resources
    withName: buildRelease {
        cpus = 2
        memory = '8 GB'
        time = '30m'
    }

    withName: indexDatabase {
        cpus = 2
        memory = '8 GB'
        time = '2h'
    }

    withName: searchAllVsAll {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 1  // Run 1 search at a time (TEA k=10 needs ~92GB, use 100GB to be safe)
    }
}

// Executor configuration
executor {
    name = 'local'
    cpus = 8
    memory = '128 GB'
}
